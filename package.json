{
  "name": "gnosis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch src/server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node src/server/index.mjs",
    "test": "node --test",
    "validate:sample": "node scripts/validate-deck.mjs fixtures/sample-deck.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.561.0",
    "openai": "^6.15.0",
    "vite": "^7.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
